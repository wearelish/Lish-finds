# Docker ignore file for LishFind Frontend

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (if using build process)
dist/
build/

# Development files
.env.local
.env.development
.env.test

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git files
.git/
.gitignore
.gitattributes

# Docker files
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
README.md
LICENSE
docs/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# Cache
.cache/

# Testing
coverage/
.nyc_output

# Backup files
*.bak
*.orig

# Package manager files (keep package.json but ignore lock files if not needed)
package-lock.json
yarn.lock