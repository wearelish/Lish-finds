# LishFind Docker Environment Variables
# Copy this file to .env.production for production deployment

# Database Configuration
POSTGRES_DB=lishfind
POSTGRES_USER=lishfind
POSTGRES_PASSWORD=change_this_secure_password_in_production
DB_PASSWORD=change_this_secure_password_in_production

# Application Security
SECRET_KEY=generate-a-very-long-secure-secret-key-for-production-use
JWT_SECRET=another-very-long-secure-jwt-secret-key

# CORS Configuration (update with your actual domains)
CORS_ORIGINS=http://localhost:3000,https://your-domain.com
ALLOWED_HOSTS=localhost,your-backend-domain.com

# SSL/TLS (for production)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Monitoring (optional)
ENABLE_METRICS=true
ENABLE_LOGGING=true

# External Services (optional)
# OPENAI_API_KEY=your_openai_key_here
# GEMINI_API_KEY=your_gemini_key_here
# GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Email Configuration (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password