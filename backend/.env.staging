# LishFind Backend - STAGING Configuration
# Testing environment with production-like settings but more permissive

# Application
DEBUG=false
ENVIRONMENT=staging
HOST=0.0.0.0
PORT=8000
VERSION=1.0.0

# Security Settings - Similar to production but more permissive for testing
HTTPS_ONLY=false
SECURE_COOKIES=false
CSRF_PROTECTION=true
TRUST_HOST_HEADERS=true

# Security
SECRET_KEY=staging-secret-key-change-this-for-your-staging-environment-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Enhanced Security - More lenient for testing
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
JWT_BLACKLIST_ENABLED=true
PASSWORD_MIN_LENGTH=6

# CORS and Allowed Hosts - More permissive for testing
CORS_ORIGINS=http://localhost:3000,https://staging.yourdomain.com
ALLOWED_HOSTS=*

# Database - Can use PostgreSQL or SQLite
DATABASE_URL=postgresql+asyncpg://lishfind:staging_password@staging-db:5432/lishfind_staging
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Cache - Optional for staging
REDIS_URL=redis://staging-redis:6379/0
CACHE_TTL_SECONDS=1800

# AI Provider - Can use mock responses to save costs
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Email - Use sandbox/testing SMTP
EMAIL_ENABLED=true
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=staging_email_user
SMTP_PASSWORD=staging_email_pass
EMAIL_FROM=test@staging.yourdomain.com

# File Storage - Local for staging
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# Maps Provider - Use free provider for staging
MAPS_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=

# Rate Limiting - More lenient for testing
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200
API_RATE_LIMIT_PER_HOUR=2000

# DDoS Protection - Relaxed for testing
MAX_REQUEST_SIZE=5242880
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=60

# Search Configuration
DEFAULT_SEARCH_RADIUS_KM=15.0
MAX_SEARCH_RESULTS=50

# Logging - Debug friendly
LOG_LEVEL=DEBUG
LOG_FORMAT=text
ENABLE_ACCESS_LOGS=true
LOG_RETENTION_DAYS=7

# Monitoring and Health
HEALTH_CHECK_INTERVAL=60
METRICS_ENABLED=true

# Performance Settings
WORKER_PROCESSES=2
KEEPALIVE_TIMEOUT=5
MAX_KEEPALIVE_REQUESTS=1000
GZIP_COMPRESSION=true