# LishFind Backend - Render.com Environment Variables
# Copy these to your Render service environment variables

# Application Settings
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security (Render will generate SECRET_KEY automatically)
SECRET_KEY=your-secret-key-will-be-generated-by-render
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (Set this to your Supabase connection string)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# CORS and Security
CORS_ORIGINS=https://lishfind-frontend.vercel.app,http://localhost:3000
ALLOWED_HOSTS=lishfind-backend.onrender.com,localhost

# Disable expensive features for free tier
AI_PROVIDER=disabled
REDIS_URL=
EMAIL_ENABLED=false
STORAGE_TYPE=local

# Free tier optimizations
MAPS_PROVIDER=nominatim
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
WORKER_PROCESSES=1

# Performance settings for free tier
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
MAX_SEARCH_RESULTS=20
CACHE_TTL_SECONDS=1800