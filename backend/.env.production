# LishFind Backend - PRODUCTION Configuration for Render + Supabase
# This configuration is for free cloud deployment

# Application
DEBUG=false
ENVIRONMENT=production
HOST=0.0.0.0
PORT=10000

# Security - Will be generated by Render
SECRET_KEY=${SECRET_KEY}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS and Allowed Hosts - Update these with your actual domains
CORS_ORIGINS=https://your-lishfind-app.vercel.app,https://localhost:3000
ALLOWED_HOSTS=your-lishfind-backend.onrender.com,localhost

# Database - Supabase PostgreSQL (FREE tier)
DATABASE_URL=${DATABASE_URL}
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Cache - Memory-based (no Redis required for free tier)
CACHE_TTL_SECONDS=3600

# AI Provider - DISABLED (no paid API keys required)
AI_PROVIDER=disabled

# Email - DISABLED (no SMTP required for MVP)
EMAIL_ENABLED=false

# File Storage - Local storage on Render
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# Maps Provider - FREE OpenStreetMap
MAPS_PROVIDER=nominatim

# Rate Limiting - Moderate for free tier
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=150

# Search Configuration
DEFAULT_SEARCH_RADIUS_KM=15.0
MAX_SEARCH_RESULTS=50

# Logging - Production settings
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_ACCESS_LOGS=true

# Performance - Free tier optimized
WORKER_PROCESSES=1
KEEPALIVE_TIMEOUT=5
MAX_KEEPALIVE_REQUESTS=1000
GZIP_COMPRESSION=true

# Security - Production hardening
HTTPS_ONLY=true
SECURE_COOKIES=true
CSRF_PROTECTION=true
BCRYPT_ROUNDS=12
JWT_BLACKLIST_ENABLED=true