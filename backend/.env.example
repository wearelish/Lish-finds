# LishFind Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Application
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS and Allowed Hosts
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=*

# Database
DATABASE_URL=postgresql://username:password@localhost/lishfind
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Redis Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# AI Provider Configuration
AI_PROVIDER=openai

# OpenAI (required if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000

# Google Gemini (required if AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro

# Email Configuration (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@lishfind.com

# File Storage
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# AWS S3 (for production storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=lishfind-uploads

# Maps Provider
MAPS_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# Search Configuration
DEFAULT_SEARCH_RADIUS_KM=10.0
MAX_SEARCH_RESULTS=50

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json